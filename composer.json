{
    "name": "demenageur/plateforme",
    "description": "Plateforme de mise en relation entre particuliers et déménageurs professionnels",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.4.0",
        "stripe/stripe-php": "^10.0",
        "phpmailer/phpmailer": "^6.8",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "classes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "post-install-cmd": [
            "php -r \"copy('.env.example', '.env');\""
        ]
    }
}
