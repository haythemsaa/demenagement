# Configuration Base de Données
DB_HOST=localhost
DB_NAME=demenagement
DB_USER=root
DB_PASS=

# Configuration Stripe
STRIPE_MODE=test
STRIPE_PUBLIC_KEY_TEST=pk_test_VOTRE_CLE_PUBLIQUE_TEST
STRIPE_SECRET_KEY_TEST=sk_test_VOTRE_CLE_SECRETE_TEST
STRIPE_PUBLIC_KEY_LIVE=pk_live_VOTRE_CLE_PUBLIQUE_LIVE
STRIPE_SECRET_KEY_LIVE=sk_live_VOTRE_CLE_SECRETE_LIVE
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_SECRET_WEBHOOK

# IDs des produits Stripe (à créer sur le dashboard Stripe)
STRIPE_PRICE_BASIC_MONTHLY=price_XXXXX
STRIPE_PRICE_BASIC_YEARLY=price_XXXXX
STRIPE_PRICE_PRO_MONTHLY=price_XXXXX
STRIPE_PRICE_PRO_YEARLY=price_XXXXX
STRIPE_PRICE_PREMIUM_MONTHLY=price_XXXXX
STRIPE_PRICE_PREMIUM_YEARLY=price_XXXXX

# Configuration Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-app
SMTP_FROM_EMAIL=noreply@demenageur.com
SMTP_FROM_NAME=Déménageur.com

# URLs de l'application
APP_URL=https://www.demenageur.com
APP_ENV=production

# Sécurité
SESSION_LIFETIME=7200
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5

# Configuration des Leads
LEAD_MATCH_RADIUS_KM=50
MAX_DEMENAGEURS_PER_LEAD=5
LEAD_COMMISSION_PERCENT=15

# Notifications
ADMIN_EMAIL=admin@demenageur.com
SUPPORT_EMAIL=support@demenageur.com
