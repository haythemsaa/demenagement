# ============================================
# .htaccess - Déménageur.com
# Configuration Apache pour sécurité et performance
# ============================================

# Activer le moteur de réécriture
RewriteEngine On

# ============================================
# 1. SÉCURITÉ
# ============================================

# Bloquer l'accès aux fichiers sensibles
<FilesMatch "^(\.env|\.env\.example|\.gitignore|composer\.json|composer\.lock|install\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Désactiver l'indexation des répertoires
Options -Indexes

# Désactiver la signature du serveur
ServerSignature Off

# Protéger contre les attaques XSS
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header always append X-Frame-Options SAMEORIGIN
    Header set X-Content-Type-Options nosniff
</IfModule>

# ============================================
# 2. PERFORMANCE - Compression Gzip
# ============================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
</IfModule>

# ============================================
# 3. CACHE NAVIGATEUR
# ============================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ============================================
# 4. PAGES D'ERREUR
# ============================================

ErrorDocument 404 /errors/404.php
ErrorDocument 500 /errors/500.php

# ============================================
# FIN
# ============================================
